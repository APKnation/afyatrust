# AfyaTrust backend configuration — copy to backend/.env and fill in.
# This file lives at backend/.env (next to venv/, above the Django project).

DEBUG=True
SECRET_KEY=<django-secret>
# Stable, random key used only to derive pseudonymous patient references on-chain.
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep the same value when deploying a replacement contract and migrating state.
CHAIN_ID_SECRET=

# PostgreSQL
DB_NAME=afyatrust
DB_USER=postgres
DB_PASSWORD=<db-password>
DB_HOST=localhost
DB_PORT=5432

# Sepolia testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<YOUR_KEY>
CONTRACT_ADDRESS=0x<printed by: npx hardhat run scripts/deploy.js --network sepolia>

# Facility wallet that pays gas (can be the same as the deployer wallet)
FACILITY_PRIVATE_KEY=0x<64 hex chars>

# 32-byte AES key encrypting custodial patient keys (hex or base64)
# Generate: python -c "import secrets; print(secrets.token_bytes(32).hex())"
MASTER_KEY=<64 hex chars>
