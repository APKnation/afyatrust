# AfyaTrust contract deployment (Sepolia testnet) — copy to blockchain/.env.
# This file lives at blockchain/.env (next to hardhat.config.js).
# Get free test ETH: https://sepoliafaucet.com
# RPC endpoints (free): https://www.infura.io or https://www.alchemy.com
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (free) — verifies the contract so "Read Contract" appears.
# Get one: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
